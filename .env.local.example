# PostgreSQL Database Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://username:password@localhost:5432/cwt-jobs

# JWT Secret Key for Admin Authentication Sessions
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Default Admin Password for initial setup & fallback
ADMIN_DEFAULT_PASSWORD=YourStrongAdminPasswordHere
